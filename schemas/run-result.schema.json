{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-harness-canonico/schemas/run-result.schema.json",
  "title": "Run Result",
  "type": "object",
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "run_id": { "type": "string", "minLength": 1 },
    "exit_code": { "type": ["integer", "null"] },
    "tasks": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "gate": { "type": "string", "enum": ["verde", "vermelho", "not_run"] },
    "review": { "type": "string", "enum": ["aprovado", "aprovado com ressalvas", "bloqueado", "not_run"] },
    "human_interventions": { "type": "integer", "minimum": 0 },
    "error_summary": { "type": ["string", "null"] }
  },
  "required": [
    "schema_version",
    "run_id",
    "exit_code",
    "tasks",
    "gate",
    "review",
    "human_interventions",
    "error_summary"
  ],
  "additionalProperties": false
}
