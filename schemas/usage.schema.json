{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-harness-canonico/schemas/usage.schema.json",
  "title": "Usage",
  "type": "object",
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "run_id": { "type": "string", "minLength": 1 },
    "usage_by_model": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "model_id": { "type": "string", "minLength": 1 },
          "correlation_id": { "type": ["string", "null"] },
          "input": { "type": "integer", "minimum": 0 },
          "output": { "type": "integer", "minimum": 0 },
          "cache_read": { "type": "integer", "minimum": 0 },
          "cache_write": { "type": "integer", "minimum": 0 },
          "reasoning": { "type": "integer", "minimum": 0 }
        },
        "required": [
          "model_id",
          "correlation_id",
          "input",
          "output",
          "cache_read",
          "cache_write",
          "reasoning"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": ["schema_version", "run_id", "usage_by_model"],
  "additionalProperties": false
}
