      "Bash(cp /home/fabiano/agent-harness-canonico/.claude/kb/dbt/quick-reference.md /home/fabiano/agent-harness-canonico/.cursor/kb/dbt/quick-reference.md)",
      "Bash(cp /home/fabiano/agent-harness-canonico/.claude/kb/dbt/concepts/*.md /home/fabiano/agent-harness-canonico/.cursor/kb/dbt/concepts/)",
